// Cloudflare Workers static assets config (Workers Builds runs `npm run build` then `npx wrangler deploy`).
// `name` must match the Worker project name in the Cloudflare dashboard.
{
  "name": "obses-website",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
