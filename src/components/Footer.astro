---
import { site } from '../config/site';
import Logo from './Logo.astro';
import { getCollection } from 'astro:content';

const features = (await getCollection('features'))
  .filter((f) => f.data.status === 'available')
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 6);
const useCases = (await getCollection('useCases')).sort((a, b) => a.data.order - b.data.order).slice(0, 6);
const year = new Date().getFullYear();
---
<footer class="mt-24 border-t border-line bg-surface">
  <div class="container-x grid gap-10 py-12 sm:grid-cols-2 lg:grid-cols-5">
    <div class="lg:col-span-2">
      <a href="/" class="flex items-center gap-2 font-bold text-lg"><Logo /></a>
      <p class="mt-3 max-w-xs text-sm text-muted">{site.tagline} Websites, web apps and Android apps from a description in your own language.</p>
      <p class="mt-3 text-sm text-muted">{site.status}</p>
    </div>
    <nav aria-label="Features">
      <h2 class="text-sm font-semibold">Features</h2>
      <ul class="mt-3 space-y-2 text-sm">
        {features.map((f) => <li><a class="text-muted hover:text-fg" href={`/features/${f.id}`}>{f.data.shortTitle}</a></li>)}
        <li><a class="text-muted hover:text-fg" href="/features">All features</a></li>
      </ul>
    </nav>
    <nav aria-label="Use cases">
      <h2 class="text-sm font-semibold">Use cases</h2>
      <ul class="mt-3 space-y-2 text-sm">
        {useCases.map((u) => <li><a class="text-muted hover:text-fg" href={`/use-cases/${u.id}`}>{u.data.shortTitle}</a></li>)}
        <li><a class="text-muted hover:text-fg" href="/use-cases">All use cases</a></li>
      </ul>
    </nav>
    <nav aria-label="Company">
      <h2 class="text-sm font-semibold">Company</h2>
      <ul class="mt-3 space-y-2 text-sm">
        <li><a class="text-muted hover:text-fg" href="/why-obsess">Why Obsess</a></li>
        <li><a class="text-muted hover:text-fg" href="/compare">Compare</a></li>
        <li><a class="text-muted hover:text-fg" href="/benchmarks">Benchmarks</a></li>
        <li><a class="text-muted hover:text-fg" href="/pricing">Pricing</a></li>
        <li><a class="text-muted hover:text-fg" href="/about">About</a></li>
        <li><a class="text-muted hover:text-fg" href="/contact">Contact</a></li>
        <li><a class="text-muted hover:text-fg" href="/privacy">Privacy</a></li>
        <li><a class="text-muted hover:text-fg" href="/terms">Terms</a></li>
      </ul>
    </nav>
  </div>
  <div class="border-t border-line">
    <p class="container-x py-6 text-sm text-muted">© {year} {site.name}</p>
  </div>
</footer>
