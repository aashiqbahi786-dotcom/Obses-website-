---
/** Decorative builder mockup (pure HTML/CSS): a phone with the chat and a live preview card. */
import Icon from './Icon.astro';
---
<div class="relative mx-auto w-full max-w-[22rem]" aria-hidden="true">
  <div class="absolute inset-0 -z-10 scale-110 rounded-[3rem] opacity-60 blur-2xl" style="background: radial-gradient(60% 60% at 50% 40%, var(--accent-soft), transparent 70%);"></div>
  <div class="rounded-[2.25rem] border border-line bg-bg p-3 shadow-2xl">
    <div class="mx-auto mb-3 h-1.5 w-16 rounded-full bg-line"></div>
    <div class="rounded-[1.5rem] bg-surface p-3">
      <div class="flex items-center justify-between px-1 pb-3 text-xs font-semibold text-muted">
        <span class="inline-flex items-center gap-1.5"><span class="inline-flex h-5 w-5 items-center justify-center rounded-md bg-accent text-[10px] font-extrabold text-accent-contrast">O</span> Build</span>
        <span class="inline-flex items-center gap-1 rounded-full bg-bg px-2 py-0.5"><Icon name="coins" size={12} /> est. 2 credits</span>
      </div>
      <div class="ml-auto max-w-[85%] rounded-2xl rounded-br-sm bg-accent px-3 py-2 text-sm text-accent-contrast">
        Mera eggs business hai, website banado 🥚
      </div>
      <div class="mt-2 max-w-[90%] rounded-2xl rounded-bl-sm bg-bg px-3 py-2 text-sm">
        Bana diya! Home, rates aur delivery areas ready hain.
        <span class="mt-1.5 flex items-center gap-1 text-xs font-semibold text-accent"><Icon name="badge-check" size={14} /> Typecheck + build passed</span>
      </div>
      <div class="mt-3 overflow-hidden rounded-xl border border-line bg-bg">
        <div class="flex items-center gap-1 border-b border-line px-2 py-1.5">
          <span class="h-1.5 w-1.5 rounded-full bg-line"></span><span class="h-1.5 w-1.5 rounded-full bg-line"></span><span class="h-1.5 w-1.5 rounded-full bg-line"></span>
          <span class="ml-2 text-[10px] text-muted">desi-eggs.obsess.app</span>
        </div>
        <div class="p-3">
          <div class="h-16 rounded-lg" style="background: linear-gradient(135deg, var(--accent), var(--accent-hover));"></div>
          <div class="mt-2 h-2.5 w-3/4 rounded bg-line"></div>
          <div class="mt-1.5 h-2 w-1/2 rounded bg-line"></div>
          <div class="mt-3 grid grid-cols-3 gap-1.5">
            <div class="h-10 rounded-md bg-surface"></div><div class="h-10 rounded-md bg-surface"></div><div class="h-10 rounded-md bg-surface"></div>
          </div>
        </div>
      </div>
      <div class="mt-3 flex gap-2">
        <span class="flex-1 rounded-full bg-accent py-2 text-center text-xs font-semibold text-accent-contrast">Publish</span>
        <span class="flex-1 rounded-full border border-line bg-bg py-2 text-center text-xs font-semibold">Launchpad</span>
      </div>
    </div>
  </div>
</div>
