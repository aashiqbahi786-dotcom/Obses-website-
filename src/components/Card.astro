---
import Icon from './Icon.astro';
import Badge from './Badge.astro';
interface Props {
  href?: string;
  icon?: string;
  title: string;
  text: string;
  comingSoon?: boolean;
  headingLevel?: 'h2' | 'h3';
}
const { href, icon, title, text, comingSoon = false, headingLevel = 'h3' } = Astro.props;
const H = headingLevel;
const Tag = href ? 'a' : 'div';
---
<Tag
  href={href}
  class:list={[
    'flex h-full flex-col rounded-md border border-line bg-bg p-5',
    href && 'transition hover:-translate-y-0.5 hover:border-accent hover:shadow-lg',
  ]}
>
  <div class="flex items-center justify-between gap-2">
    {icon && <span class="icon-tile inline-flex h-12 w-12 items-center justify-center rounded-md text-accent-contrast"><Icon name={icon} size={22} /></span>}
    {comingSoon && <Badge />}
  </div>
  <H class="mt-4 font-semibold">{title}</H>
  <p class="mt-2 text-sm text-muted">{text}</p>
</Tag>
