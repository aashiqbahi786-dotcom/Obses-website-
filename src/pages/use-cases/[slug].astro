---
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import Card from '../../components/Card.astro';
import Faq from '../../components/Faq.astro';
import Cta from '../../components/Cta.astro';
import { faqPage } from '../../lib/schema';
import { staticPages } from '../../lib/pages';
import { resolveRefs } from '../../lib/refs';

export async function getStaticPaths() {
  const items = await getCollection('useCases');
  return items.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
interface Props {
  entry: CollectionEntry<'useCases'>;
}
const { entry } = Astro.props;
const u = entry.data;
const path = `/use-cases/${entry.id}`;
const used = await resolveRefs(u.features);
---
<Base
  title={u.metaTitle}
  description={u.description}
  path={path}
  crumbs={[{ label: staticPages.useCases.label, path: '/use-cases' }, { label: u.shortTitle, path }]}
  schema={u.faq.length ? [faqPage(u.faq)] : []}
>
  <PageHeader title={u.title} answer={u.answer} />

  <section class="container-x prose-o max-w-3xl py-6">
    <h2>What problem does this solve?</h2>
    <p>{u.problem}</p>
    <h2>What does Obsess build for you?</h2>
    <ul>{u.builds.map((b) => <li>{b}</li>)}</ul>
  </section>

  <section class="container-x py-6" aria-labelledby="prompt">
    <h2 id="prompt" class="text-2xl font-bold">What should I type?</h2>
    <div class="mt-4 grid gap-4 md:grid-cols-2">
      <figure class="rounded-md border border-line bg-surface p-5">
        <figcaption class="text-xs font-semibold uppercase tracking-wide text-muted">Hinglish</figcaption>
        <p class="mt-2 font-medium" lang="hi-Latn">“{u.promptHinglish}”</p>
      </figure>
      <figure class="rounded-md border border-line bg-surface p-5">
        <figcaption class="text-xs font-semibold uppercase tracking-wide text-muted">English</figcaption>
        <p class="mt-2 font-medium">“{u.promptEnglish}”</p>
      </figure>
    </div>
  </section>

  <section class="container-x py-8" aria-labelledby="uses">
    <h2 id="uses" class="text-2xl font-bold">Which products and features does it use?</h2>
    <ul class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {used.map((f) => (
        <li><Card href={f.href} icon={f.icon} title={f.title} text={f.text} comingSoon={f.comingSoon} /></li>
      ))}
    </ul>
  </section>

  <Faq items={u.faq} />
  <Cta />
</Base>
