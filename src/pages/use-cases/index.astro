---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import Card from '../../components/Card.astro';
import Cta from '../../components/Cta.astro';
import { staticPages } from '../../lib/pages';

const meta = staticPages.useCases;
const items = (await getCollection('useCases')).sort((a, b) => a.data.order - b.data.order);
---
<Base title={meta.title} description={meta.description} path={meta.path} crumbs={[{ label: meta.label, path: meta.path }]}>
  <PageHeader
    title="What people build with Obsess"
    answer="Obsess is used by small businesses, creators, students, startup founders and agencies who want a website or app without coding. Each page below shows the problem, what Obsess builds, an example request in Hinglish and English, and which features it uses, so you can start with a request that already works."
  />
  <section class="container-x py-8">
    <h2 class="sr-only">All use cases</h2>
    <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {items.map((u) => <li><Card href={`/use-cases/${u.id}`} icon={u.data.icon} title={u.data.shortTitle} text={u.data.problem} /></li>)}
    </ul>
  </section>
  <Cta />
</Base>
