---
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import Card from '../../components/Card.astro';
import Faq from '../../components/Faq.astro';
import Cta from '../../components/Cta.astro';
import Icon from '../../components/Icon.astro';
import { faqPage } from '../../lib/schema';
import { staticPages } from '../../lib/pages';
import { resolveRefs } from '../../lib/refs';

export async function getStaticPaths() {
  const all = await getCollection('features');
  return all.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
interface Props {
  entry: CollectionEntry<'features'>;
}
const { entry } = Astro.props;
const f = entry.data;
const soon = f.status === 'coming-soon';
const path = `/features/${entry.id}`;
const related = await resolveRefs(f.related);
---
<Base
  title={f.metaTitle}
  description={f.description}
  path={path}
  crumbs={[{ label: staticPages.features.label, path: '/features' }, { label: f.shortTitle, path }]}
  schema={f.faq.length ? [faqPage(f.faq)] : []}
>
  <PageHeader title={f.title} answer={f.answer} comingSoon={soon} />

  {soon && (
    <div class="container-x">
      <p role="note" class="rounded-md bg-warn-soft px-4 py-3 text-sm text-warn-text">
        <strong>Coming soon.</strong> This feature is planned and not available yet. Everything below describes the plan.
      </p>
    </div>
  )}

  <section class="container-x prose-o max-w-3xl py-6">
    {f.sections.map((s) => (
      <>
        <h2>{s.q}</h2>
        <p>{s.a}</p>
      </>
    ))}
    {f.limits.length > 0 && (
      <>
        <h2>What are the limits today?</h2>
        <ul>{f.limits.map((l) => <li>{l}</li>)}</ul>
      </>
    )}
  </section>

  {related.length > 0 && (
    <section class="container-x py-8" aria-labelledby="related">
      <h2 id="related" class="text-2xl font-bold">Related products and features</h2>
      <ul class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {related.map((r) => (
          <li><Card href={r.href} icon={r.icon} title={r.title} text={r.text} comingSoon={r.comingSoon} /></li>
        ))}
      </ul>
      <p class="mt-6"><a href="/features" class="inline-flex items-center gap-1 font-semibold text-accent">All features <Icon name="arrow-right" size={16} /></a></p>
    </section>
  )}

  <Faq items={f.faq} />
  <Cta />
</Base>
