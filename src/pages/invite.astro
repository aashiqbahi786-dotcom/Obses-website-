---
/**
 * Invite form. The provider is not chosen yet (founder decision), so the form
 * opens the visitor's email app with the details filled in. Swap `action`
 * when a provider is picked; the fields stay the same.
 */
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { staticPages } from '../lib/pages';
import { site } from '../config/site';

const meta = staticPages.invite;
const mailto = `mailto:${site.contactEmail}?subject=${encodeURIComponent(`${site.name} Alpha invite request`)}`;
const field = 'mt-1 block w-full rounded-sm border border-line bg-bg px-3 py-2.5 text-base';
---
<Base title={meta.title} description={meta.description} path={meta.path} crumbs={[{ label: meta.label, path: meta.path }]}>
  <PageHeader
    title="Request an invite"
    answer={`${site.name} is in invite-only Alpha, so we are letting people in a few at a time. Tell us your name, your email and what you want to build — in any language — and we will contact you when a place opens. There is no payment and no commitment to join the list.`}
  />
  <section class="container-x max-w-xl py-4" aria-labelledby="form-title">
    <h2 id="form-title" class="text-xl font-bold">Your details</h2>
    <form data-invite class="mt-4 space-y-4" action={mailto} method="post" enctype="text/plain">
      <div>
        <label for="name" class="text-sm font-medium">Name</label>
        <input id="name" name="name" type="text" autocomplete="name" required class={field} />
      </div>
      <div>
        <label for="email" class="text-sm font-medium">Email</label>
        <input id="email" name="email" type="email" autocomplete="email" required class={field} />
      </div>
      <div>
        <label for="idea" class="text-sm font-medium">What do you want to build?</label>
        <textarea id="idea" name="idea" rows="4" class={field} placeholder="Mera eggs business hai, website banado"></textarea>
      </div>
      <button type="submit" class="w-full rounded-sm bg-accent px-6 py-3 font-semibold text-accent-contrast hover:bg-accent-hover">Send request</button>
      <p class="text-sm text-muted">This opens your email app with your details filled in. Prefer to write yourself? Email <a class="text-accent underline" href={mailto}>{site.contactEmail}</a>. See our <a class="text-accent underline" href="/privacy">privacy policy</a>.</p>
    </form>
  </section>
  <script is:inline define:vars={{ to: site.contactEmail, subject: `${site.name} Alpha invite request` }}>
    var form = document.querySelector('[data-invite]');
    if (form) form.addEventListener('submit', function (e) {
      e.preventDefault();
      var d = new FormData(form);
      var body = 'Name: ' + d.get('name') + '\nEmail: ' + d.get('email') + '\nI want to build: ' + d.get('idea');
      window.location.href = 'mailto:' + to + '?subject=' + encodeURIComponent(subject) + '&body=' + encodeURIComponent(body);
    });
  </script>
</Base>
