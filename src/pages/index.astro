---
import { getCollection, getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Card from '../components/Card.astro';
import Faq from '../components/Faq.astro';
import Cta from '../components/Cta.astro';
import Icon from '../components/Icon.astro';
import SectionHeader from '../components/SectionHeader.astro';
import HeroMockup from '../components/HeroMockup.astro';
import { staticPages } from '../lib/pages';
import { faqPage, softwareApplication } from '../lib/schema';
import { usps, steps } from '../lib/usp';
import { latestRun } from '../lib/benchmarks';
import { sortedProducts } from '../lib/refs';

const meta = staticPages.home;
const faq = (await getEntry('faq', 'home'))!.data.items;
const useCases = (await getCollection('useCases')).sort((a, b) => a.data.order - b.data.order);
const competitors = (await getCollection('compare')).sort((a, b) => a.data.order - b.data.order);
const answer =
  'Obsess is an AI builder for people who do not code. Describe your idea in plain words — English, Hinglish, Hindi or Banglish — and Obsess builds a website, web app, Android app, AI agent or 3D scroll website, checks it and publishes it. It works from your phone, and you see the cost before every task.';
const products = await sortedProducts();
const grow = [
  { icon: 'rocket', title: 'Showcase your product', text: 'List what you built on Launchpad with screenshots and a live demo, in front of people looking for new products.', href: '/features/launchpad' },
  { icon: 'message-square-heart', title: 'Get reviews and feedback', text: 'Visitors try your app and leave ratings and feedback. Read it all in your creator dashboard.', href: '/features/launchpad' },
  { icon: 'users', title: 'Test your MVP with early users', text: 'Real people try your first version, so you learn what works before a bigger launch.', href: '/features/launchpad' },
  { icon: 'megaphone', title: 'Free ads promotion', text: 'Paid plans include a promotion coupon to promote your app inside Obsess — free ad credit.', href: '/features/ads-promotion' },
];
const graph = [
  { icon: 'scan-search', title: 'Context Retrieval', text: 'Sends the AI only the code a task needs — fewer tokens.' },
  { icon: 'shield-check', title: 'Hallucination Guard', text: 'Checks every file and function the AI mentions really exists.' },
  { icon: 'lock', title: 'Scope Lock', text: 'Keeps edits inside the files a task should touch.' },
  { icon: 'git-fork', title: 'Impact Analysis', text: 'Shows what a change affects before it is made.' },
  { icon: 'brain', title: 'Project Memory', text: 'Remembers key decisions about your app.' },
  { icon: 'layers', title: 'Smart cache', text: 'Never pays twice for the same work.' },
];
const strip = latestRun.results.filter((r) => ['android-requirements', 'android-preview', 'publishing'].includes(r.id));
---
<Base
  title={meta.title}
  description={meta.description}
  path={meta.path}
  schema={[softwareApplication(meta.description), faqPage(faq)]}
>
  <section class="container-x grid items-center gap-12 pt-10 pb-12 md:pt-16 lg:grid-cols-[1.15fr_0.85fr]">
    <div>
      <p class="inline-flex items-center gap-2 rounded-full border border-line px-3 py-1 text-sm text-muted">
        <span class="h-2 w-2 rounded-full bg-accent" aria-hidden="true"></span> Build · Launch · Grow
      </p>
      <h1 class="mt-5 text-4xl font-extrabold md:text-6xl">
        Build websites, apps, AI agents and 3D sites by just describing them
      </h1>
      <p data-answer class="mt-6 max-w-2xl text-lg text-muted md:text-xl">{answer}</p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href="/invite" class="inline-flex items-center justify-center gap-2 rounded-sm bg-accent px-6 py-3 font-semibold text-accent-contrast hover:bg-accent-hover">Start building <Icon name="arrow-right" size={18} /></a>
        <a href="/product" class="inline-flex items-center justify-center rounded-sm border border-line px-6 py-3 font-semibold hover:bg-surface">See how it works</a>
      </div>
      <ul class="mt-8 flex flex-wrap gap-x-5 gap-y-2 text-sm text-muted">
        <li class="inline-flex items-center gap-1.5"><span class="text-accent"><Icon name="languages" size={16} /></span> Hinglish, Hindi, Banglish</li>
        <li class="inline-flex items-center gap-1.5"><span class="text-accent"><Icon name="smartphone" size={16} /></span> Works from your phone</li>
        <li class="inline-flex items-center gap-1.5"><span class="text-accent"><Icon name="calculator" size={16} /></span> Cost shown first</li>
      </ul>
    </div>
    <HeroMockup />
  </section>

  <section class="container-x py-12" aria-labelledby="how">
    <SectionHeader id="how" title="How does Obsess work?" intro="Four steps, all from one chat." />
    <ol class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {steps.map((s, i) => (
        <li class="rounded-md border border-line p-5">
          <span class="icon-tile inline-flex h-12 w-12 items-center justify-center rounded-md text-accent-contrast"><Icon name={s.icon} size={22} /></span>
          <h3 class="mt-4 font-semibold">{i + 1}. {s.title}</h3>
          <p class="mt-2 text-sm text-muted">{s.text}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="container-x py-12" aria-labelledby="what">
    <SectionHeader id="what" title="What can I build with Obsess?" intro="Five products, one chat." />
    <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {products.map((p) => (
        <li><Card href={`/${p.id}`} icon={p.data.icon} title={p.data.name} text={p.data.tagline} comingSoon={p.data.status === 'coming-soon'} /></li>
      ))}
    </ul>
    <p class="mt-6"><a href="/products" class="font-semibold text-accent underline underline-offset-2">All products</a></p>
  </section>

  <section class="container-x py-12" aria-labelledby="grow">
    <div class="rounded-lg border border-line bg-surface p-6 md:p-10">
      <SectionHeader id="grow" title="How do I get my first users?" intro="Obsess does not stop at “your app is live”. Launch it, get feedback and grow." />
      <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {grow.map((g) => <li><Card {...g} /></li>)}
      </ul>
    </div>
  </section>

  <section class="py-12" aria-labelledby="graph">
    <div class="bg-[#0b0f17] py-14 text-[#f3f6fb]">
      <div class="container-x">
        <p class="inline-flex items-center gap-2 text-sm font-semibold text-[#7aa3f2]"><Icon name="waypoints" size={18} /> Smart code graph</p>
        <h2 id="graph" class="mt-3 max-w-3xl text-2xl font-bold md:text-4xl">Why does Obsess use fewer tokens?</h2>
        <p class="mt-4 max-w-3xl text-[#a3aec2]">Obsess keeps a live graph of your project. Instead of sending the whole codebase to the AI, it sends only what a task needs — so every task uses fewer tokens and costs less, and the AI checks its work against your real code.</p>
        <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {graph.map((g) => (
            <li class="flex gap-3 rounded-md border border-[#232c3f] bg-[#121826] p-4">
              <span class="mt-0.5 shrink-0 text-[#7aa3f2]"><Icon name={g.icon} /></span>
              <span><span class="block font-semibold">{g.title}</span><span class="text-sm text-[#a3aec2]">{g.text}</span></span>
            </li>
          ))}
        </ul>
        <p class="mt-6"><a href="/features/smart-code-graph" class="inline-flex items-center gap-1 font-semibold text-[#7aa3f2] underline underline-offset-2">How the code graph works <Icon name="arrow-right" size={16} /></a></p>
      </div>
    </div>
  </section>

  <section class="container-x py-12" aria-labelledby="why">
    <SectionHeader id="why" title="Why is Obsess different?" intro="Eight reasons people choose Obsess." />
    <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {usps.map((u) => <li><Card icon={u.icon} title={u.title} text={u.text} comingSoon={u.roadmap} /></li>)}
    </ul>
    <p class="mt-6"><a href="/why-obsess" class="font-semibold text-accent underline underline-offset-2">Why Obsess, in detail</a></p>
  </section>

  <section class="container-x py-12" aria-labelledby="bench">
    <div class="rounded-lg border border-line bg-surface p-6 md:p-8">
      <SectionHeader id="bench" title="Does the AI actually build working apps?" intro={`Results from our ${latestRun.label}, ${latestRun.date}, model ${latestRun.model}. Small samples; see the method and limits.`} />
      <dl class="mt-6 grid gap-6 sm:grid-cols-3">
        {strip.map((r) => (
          <div>
            <dt class="text-sm text-muted">{r.title}</dt>
            <dd class="mt-1 text-3xl font-extrabold">{r.headline}</dd>
          </div>
        ))}
      </dl>
      <p class="mt-6"><a href="/benchmarks" class="font-semibold text-accent underline underline-offset-2">Method, results and limits</a></p>
    </div>
  </section>

  <section class="container-x py-12" aria-labelledby="cmp">
    <SectionHeader id="cmp" title="How does Obsess compare with other AI app builders?" intro="Factual tables with sources and dates. Where we could not verify a fact, we show a dash." />
    <ul class="mt-6 flex flex-wrap gap-2">
      {competitors.map((c) => (
        <li><a href={`/compare/${c.id}`} class="inline-flex rounded-full border border-line px-4 py-2 text-sm font-medium hover:border-accent">Obsess vs {c.data.name}</a></li>
      ))}
    </ul>
  </section>

  <section class="container-x py-12" aria-labelledby="uc">
    <SectionHeader id="uc" title="Who uses Obsess?" intro="Small businesses, creators, students, founders and agencies." />
    <ul class="mt-6 grid grid-cols-2 gap-3 md:grid-cols-5">
      {useCases.map((u) => (
        <li>
          <a href={`/use-cases/${u.id}`} class="flex items-center gap-2 rounded-md border border-line p-3 text-sm font-medium hover:border-accent">
            <span class="text-accent"><Icon name={u.data.icon} /></span>{u.data.shortTitle}
          </a>
        </li>
      ))}
    </ul>
  </section>

  <Faq items={faq} />
  <Cta />
</Base>
